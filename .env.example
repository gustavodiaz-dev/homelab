# chmod 600 ~/.config/gus-monitor.env

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
N8N_WEBHOOK_MAINTENANCE=https://your-n8n-instance/webhook/your-webhook-path
