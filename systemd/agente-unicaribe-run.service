[Unit]
Description=Agente Unicaribe — ejecutar actividades del día
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/gus/Projects/agente-unicaribe
ExecStart=/home/gus/Projects/agente-unicaribe/.venv/bin/python3 main.py run
EnvironmentFile=/home/gus/Projects/agente-unicaribe/.env
StandardOutput=append:/home/gus/Projects/agente-unicaribe/logs/run.log
StandardError=append:/home/gus/Projects/agente-unicaribe/logs/run.log
