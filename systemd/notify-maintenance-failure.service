[Unit]
Description=Notificar fallo de mantenimiento

[Service]
Type=oneshot
EnvironmentFile=%h/.config/gus-monitor.env
ExecStart=/usr/bin/notify-send -u critical -a "Gus Monitor" "Mantenimiento semanal falló" "Revisar: journalctl --user -u mise-upgrade -n 20"
ExecStart=/usr/bin/curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" -d "chat_id=${TELEGRAM_CHAT_ID}&text=⚠️ Mantenimiento desktop falló. Revisar journalctl --user -u mise-upgrade" --max-time 10
